<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menu_nav_graph"
    app:startDestination="@id/chatsFragment">

    <fragment
        android:id="@+id/chatsFragment"
        android:name="com.example.firebasechat.view.mainmenu.ChatsFragment"
        android:label="fragment_chats"
        tools:layout="@layout/fragment_chats" >
        <action
            android:id="@+id/action_chatsFragment_to_userProfileFragment"
            app:destination="@id/userProfileFragment" />
        <action
            android:id="@+id/action_chatsFragment_to_addChatDialogFragment"
            app:destination="@id/addChatDialogFragment" />
        <action
            android:id="@+id/action_chats_to_conversation"
            app:destination="@id/conversationFragment" />
    </fragment>
    <fragment
        android:id="@+id/userProfileFragment"
        android:name="com.example.firebasechat.view.user.UserProfileFragment"
        android:label="fragment_user_profile"
        tools:layout="@layout/fragment_user_profile" >
        <action
            android:id="@+id/action_userProfileFragment_to_authActivity"
            app:destination="@id/authActivity" />
    </fragment>
    <activity
        android:id="@+id/authActivity"
        android:name="com.example.firebasechat.view.auth.AuthActivity"
        android:label="activity_auth"
        tools:layout="@layout/activity_auth" />
    <dialog
        android:id="@+id/addChatDialogFragment"
        android:name="com.example.firebasechat.view.mainmenu.AddChatDialogFragment"
        android:label="AddChatDialogFragment"
        tools:layout="@layout/fragment_add_chat_dialog"/>
    <fragment
        android:id="@+id/conversationFragment"
        android:name="com.example.firebasechat.view.mainmenu.ConversationFragment"
        android:label="fragment_converstion"
        tools:layout="@layout/fragment_conversation" >
        <argument
            android:name="chatId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null"/>
        <action
            android:id="@+id/action_conversationFragment_to_chatsFragment"
            app:destination="@id/chatsFragment" />
    </fragment>
</navigation>