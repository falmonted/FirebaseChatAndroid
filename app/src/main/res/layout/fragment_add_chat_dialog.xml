<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/lbAddChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/lbAddChat"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblEnterUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:hint="@string/txtEmailHint"
        android:text="@string/lbEnterEmail"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/txtEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:gravity="center"
        android:hint="@string/txtEmailHint"
        android:inputType="textEmailAddress"
        android:minWidth="48dp"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btnAddUserChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/primaryColor"
        android:text="@string/lbAdd"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>